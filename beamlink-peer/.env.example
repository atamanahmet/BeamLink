# ── Agent ─────────────────────────────────────────────────────────
# Your display name on the network
PEER_NAME=MyAgent
# Default 9090. Change if port is already in use.
PEER_PORT=9090
# Peer TLS. Default 9091. LAN peers use this, not PEER_PORT.
PEER_TLS_PORT=9091
# Auto-detects LAN IP. Set manually if auto-detection fails.
PEER_IP=auto

# ── Nexus Connection ──────────────────────────────────────────────
# Full URL of your Nexus server e.g. https://192.168.1.10:7473
PEER_NEXUS_URL=https://192.168.1.1:7473

# ── UI Secret ─────────────────────────────────────────────────────
# Required. Local UI sends this as X-UI-Secret on loopback only.
PEER_UI_SECRET=change-me

# ── Upload Limits ─────────────────────────────────────────────────
# -1 = unlimited, or set with unit e.g. 100MB
MULTIPART_ENABLED=true
MULTIPART_MAX_FILE_SIZE=-1
MULTIPART_MAX_REQUEST_SIZE=-1
MULTIPART_FILE_SIZE_THRESHOLD=0
TRANSFER_EXPIRY_HOURS=24