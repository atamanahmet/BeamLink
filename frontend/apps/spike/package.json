{
  "name": "spike",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "pnpm run build && electron-builder --dir"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/dropzone": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@tailwindcss/vite": "4.3.3",
    "lucide-react": "0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "8.4.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@beamlink/ui": "workspace:*",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "postcss": "8.5.29",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "build": {
    "appId": "com.beamlink.spike",
    "productName": "Beamlink Spike",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
