{
  "name": "agent",
  "private": true,
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json --noEmit",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "dist": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@mantine/notifications": "9.6.1",
    "@tanstack/react-query": "5.104.3",
    "axios": "^1.13.5",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@beamlink/core": "workspace:*",
    "@beamlink/electron-main": "workspace:*",
    "@beamlink/features": "workspace:*",
    "@beamlink/platform": "workspace:*",
    "@beamlink/ui": "workspace:*",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "react-router": "8.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.beamlink.agent",
    "productName": "Beamlink Agent",
    "directories": {
      "buildResources": "assets"
    },
    "icon": "assets/icon.png",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "extraResources": [
      {
        "from": "../../../resources/jre",
        "to": "jre"
      },
      {
        "from": "../../../resources/agent/config",
        "to": "config"
      },
      {
        "from": "../../../resources/agent/backend",
        "to": "backend"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ]
  }
}
