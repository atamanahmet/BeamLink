{
  "name": "beamlink-frontend",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev:peer": "pnpm --filter agent dev",
    "dev:nexus": "pnpm --filter nexus dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --no-bail lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",

    "dist:peer": "pnpm --filter agent dist",
    "dist:nexus": "pnpm --filter nexus dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "5.0.3"
  }
}
